{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/box-oauth/oauth2/token",
        "function": "boxOAuthProxy"
      },
      {
        "source": "/api/box-oauth/oauth2/revoke",
        "function": "boxRevokeProxy"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "codebase": "easyeditor"
  }
}
