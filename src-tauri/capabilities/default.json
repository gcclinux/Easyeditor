{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-title",
    "shell:default",
    "shell:allow-execute",
    "shell:allow-open",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:read-all",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "fs:write-all",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://easyeditor-premium.web.app/api/check-license"
        },
        {
          "url": "https://easyai-gateway-846627640525.us-central1.run.app/api/credits/*"
        }
      ],
      "deny": []
    }
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "local": true,
  "remote": {
    "urls": []
  },
  "context": "local"
}